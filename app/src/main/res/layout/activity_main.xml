<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_liquid_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LeEco" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Smart Remote" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold"/>
                </LinearLayout>
                <TextView android:id="@+id/statusDot" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="●" android:textSize="18sp" android:textColor="@color/muted" android:background="@drawable/bg_glass_card"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/statusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:padding="16dp" android:gravity="center_vertical" android:background="@drawable/bg_glass_card">
                <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Not connected" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:id="@+id/connectAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONNECT" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:padding="8dp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/tabRemote" android:layout_width="104dp" android:layout_height="50dp" android:text="Remote"/>
                    <Button android:id="@+id/tabTouch" android:layout_width="104dp" android:layout_height="50dp" android:text="Touch"/>
                    <Button android:id="@+id/tabApps" android:layout_width="104dp" android:layout_height="50dp" android:text="Apps"/>
                    <Button android:id="@+id/tabMacro" android:layout_width="104dp" android:layout_height="50dp" android:text="Macros"/>
                    <Button android:id="@+id/tabSettings" android:layout_width="104dp" android:layout_height="50dp" android:text="Settings"/>
                    <Button android:id="@+id/tabUpdate" android:layout_width="104dp" android:layout_height="50dp" android:text="TV Update"/>
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="22dp" android:paddingBottom="8dp" android:text="Designed &amp; Developed by Rahul Dharuman" android:textColor="#425A6A" android:textSize="11sp" android:letterSpacing="0.02"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
